      "",
      "from fastapi import FastAPI",
      "",
      "app = FastAPI()",
      "",
      "",
      "@app.get(\"/invoice\")",
      "def list_invoices():",
      "    \"\"\"Return every invoice.\"\"\"",
      "    return []",
      "",
      "",
      "@app.get(\"/invoice/{id}\")",
      "def get_invoice(id: str):",
      "    \"\"\"Return one invoice by id.\"\"\"",
      "    return {\"id\": id}",
      "",
      "",
      "@app.get(\"/health\")",
      "def health():",
